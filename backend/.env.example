# ReceptAI Backend Environment Variables

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True

# Database — PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/receptai

# JWT Auth
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# DeepSeek API (OpenAI-compatible) — used for recipe generation
# Get key at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# YOLO Model Settings
YOLO_MODEL_PATH=../ml_model/models/fridgify_y11s_full/weights/best.pt
CONFIDENCE_THRESHOLD=0.5
